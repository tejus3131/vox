# Supabase (data store only -- auth handled by Better Auth)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Better Auth
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Public origin of this app (no trailing slash). Required: `next start` uses NODE_ENV=production and Better Auth rate limiting uses this; if unset you get ERR_INVALID_URL.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<your-32-char-secret>

# OpenAI-compatible LLM
LLM_API_KEY=sk_<your-api-key>
LLM_BASE_URL=https://api.asi1.ai/v1
LLM_MODEL=asi1

# Credential Encryption
ENCRYPTION_KEY=<your-64-char-hex-string>

# Razorpay
RAZORPAY_API_KEY=<your-api-key>
RAZORPAY_KEY_SECRET=<your-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# Billing rates (paise per unit)
PROMPT_TOKEN_RATE_PAISE=0.01
COMPLETION_TOKEN_RATE_PAISE=0.03
TOOL_CALL_RATE_PAISE=0.5
BILLING_MARGIN=0.4

# Resend (transactional email)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=Vox <noreply@yourdomain.com>

# Sentry (observability)
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>
SENTRY_DSN=<your-sentry-dsn>
SENTRY_ORG=<your-sentry-org>
SENTRY_PROJECT=<your-sentry-project>
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
